{
  "name": "@repo/proto",
  "version": "1.0.0",
  "license": "MIT",
   "scripts": {
  "build:cjs": "tsc --project tsconfig.cjs.json",
  "build:esm": "tsc --project tsconfig.esm.json",
  "build": "npm run build:cjs && npm run build:esm"
},
  "main": "./dist/cjs/entry.js",
  "module": "./dist/esm/entry.js",
  "types": "./dist/esm/entry.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/entry.js",
      "require": "./dist/cjs/entry.js"
    },
    "./auth.proto": "./src/ProtoFile/auth.proto",
    "./dist-auth.proto": "./src/ProtoFile/dist-auth.proto",
    "./dist-post.proto": "./src/ProtoFile/dist-post.proto",
    "./dist-like.proto": "./src/ProtoFile/dist-like.proto",
    "./dist-comment.proto" : "./src/ProtoFile/dist-comment.proto",
    "./websocket-chat.proto": "./src/ProtoFile/websocket-chat.proto"
  },
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "@repo/static-data": "1.0.0",
    "@repo/user-interfaces": "1.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.10.7",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "zod": "^4.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.1",
    "passport-jwt": "^4.0.1",
    "@nestjs/passport": "^11.0.5",
    "rxjs": "^7.8.2"
  }
}

